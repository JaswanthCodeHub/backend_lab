@baseUrl = http://localhost:5002
@username = jaswanth

### Valid registration - expected 201
POST {{baseUrl}}/register
Content-Type: application/json

{
  "username": "{{username}}",
  "name": "Jaswanth",
  "password": "Jaswanth123"
}

### Duplicate registration - expected 400
POST {{baseUrl}}/register
Content-Type: application/json

{
  "username": "{{username}}",
  "name": "Jaswanth",
  "password": "Jaswanth123"
}

### Missing registration field - expected 400
POST {{baseUrl}}/register
Content-Type: application/json

{
  "username": "{{username}}",
  "password": "Jaswanth123"
}

### Valid login - expected 200
POST {{baseUrl}}/login
Content-Type: application/json

{
  "username": "{{username}}",
  "password": "Jaswanth123"
}

### Unknown username - expected 400
POST {{baseUrl}}/login
Content-Type: application/json

{
  "username": "{{username}}_unknown",
  "password": "Jaswanth123"
}

### Incorrect password - expected 400
POST {{baseUrl}}/login
Content-Type: application/json

{
  "username": "{{username}}",
  "password": "Wrong123"
}

### Missing login field - expected 400
POST {{baseUrl}}/login
Content-Type: application/json

{
  "username": "{{username}}"
}
